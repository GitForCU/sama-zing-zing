# Copy this file to .env in the project root. Do not commit .env.
# Use a NEW Supabase project for the first setup.
SAMA_DATABASE_MODE=supabase
SAMA_AUTH_MODE=supabase
# Project URL + publishable key from the same Supabase project (not secret/service_role).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Dashboard > Connect > Session pooler. Copy the actual host and username.
# Convert the URI to JDBC format; keep the password out of the URL.
DATABASE_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USER=postgres.YOUR_PROJECT_REF
# Values are literal: $, # and = are preserved. Matching outer quotes are removed.
DATABASE_PASSWORD="YOUR_DATABASE_PASSWORD"
DATABASE_POOL_SIZE=5
# Creates sample school records on the first run of an empty database.
# Supabase Auth accounts must be created separately and linked by User ID (see docs).
# Remove demo when using real school data. The launcher adds supabase automatically.
SPRING_PROFILES_ACTIVE=demo
# Local browser still uses http://127.0.0.1:5173.
COOKIE_SECURE=false
